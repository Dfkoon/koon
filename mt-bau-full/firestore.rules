rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@makanak.local' ||
        request.auth.token.email == 'koon@makanak.local' ||
        request.auth.token.email == 'hussienaldayyat@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isCoordinator() {
      return isAuthenticated();
    }

    // 1. Academic & Quiz data: Public read, Authenticated write
    match /quiz_subjects/{subjectId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /quiz_parts/{partId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /quiz_questions/{questionId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /academic_courses/{courseId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /urgent_news/{newsId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Questions edits & audit logs
    match /question_edits/{editId} {
      allow read, write: if isCoordinator() || isAdmin();
    }

    match /quiz_audit_logs/{logId} {
      allow read: if isCoordinator() || isAdmin();
      allow create: if isCoordinator() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 3. User feedback, reports, applications (Public write with limits, Admin/Coordinator read)
    match /suggestions/{suggestionId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['content'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000;
      allow read: if isCoordinator() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /question_reports/{reportId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['questionId', 'reason'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000;
      allow read, update: if isCoordinator() || isAdmin();
      allow delete: if isAdmin();
    }

    match /coordinatorApplications/{appId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow read, update: if isCoordinator() || isAdmin();
      allow delete: if isAdmin();
    }

    match /service_requests/{reqId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['service', 'contact'])
        && request.resource.data.service is string
        && request.resource.data.service.size() <= 200;
      allow read, update: if isCoordinator() || isAdmin();
      allow delete: if isAdmin();
    }

    match /material_ratings/{ratingId} {
      allow read: if true;
      allow create: if true
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /page_views/{viewId} {
      allow create: if true;
      allow read: if isCoordinator() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /testimonials/{testId} {
      allow read: if true;
      allow create: if true
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // 4. Material Exchange & Donations
    match /materialDonations/{donationId} {
      allow read: if true;
      allow create: if true
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update: if isCoordinator() || isAdmin() || (
        // Allow public reserving/booking of an item without altering ownership or details
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerName', 'takerPhone', 'reservedAt', 'updatedAt'])
      );
      allow delete: if isAdmin() || isCoordinator();
    }

    match /materials/{materialId} {
      allow read: if true;
      allow create, update: if isCoordinator() || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Staff & Coordinators (volunteers)
    match /volunteers/{volunteerId} {
      // Allow read if authenticated or during verification lookup
      allow read: if true;

      // Allow coordinator to update their own profile fields or 2FA, but forbid modifying permissions or active state
      allow update: if isAdmin() || (
        // Coordinator can update own document
        (isAuthenticated() && (resource.data.authUid == request.auth.uid || volunteerId == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'active'])
      ) || (
        // Allow migration step to delete password field and set authUid
        !('password' in request.resource.data) && 'authUid' in request.resource.data
      );

      // Create and delete only by Admin
      allow create, delete: if isAdmin();
    }

    match /staff_status/{statusId} {
      allow read: if true;
      allow write: if isCoordinator() || isAdmin();
    }

    match /coordinatorNotifications/{notifId} {
      allow read: if isCoordinator() || isAdmin();
      allow create: if isAdmin();
      allow update: if isCoordinator() || isAdmin();
      allow delete: if isAdmin();
    }

    match /admin_notifications/{notifId} {
      allow read, update: if isCoordinator() || isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }
  }
}
